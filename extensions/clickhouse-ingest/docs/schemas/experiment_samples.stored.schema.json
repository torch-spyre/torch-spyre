    "sample_id",
    "experiment_id",
    "arm",
    "trial",
    "position",
    "warmup",
    "split",
    "status",
    "workload",
    "stratum",
    "metric",
    "value",
    "unit",
    "kind",
    "fidelity",
    "wall_s",
    "load1_before",
    "load1_after",
    "node",
    "env_id",
    "artifact_id",
    "id12",
    "run_id",
    "benchmark_id",
    "props"
