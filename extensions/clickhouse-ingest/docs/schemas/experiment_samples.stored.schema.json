    "arm": {
      "minLength": 1
    },
    "artifact_id": {},
    "benchmark_id": {},
    "env_id": {},
    "experiment_id": {
      "minLength": 1
    },
    "fidelity": {
      "enum": [
        "analytic",
        "cost_model",
        "emulator",
        "hardware"
      ]
    },
    "id12": {},
    "kind": {
      "enum": [
        "measured",
        "predicted"
      ]
    },
    "load1_after": {},
    "load1_before": {},
    "metric": {},
