{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.bench.invalid/v1alpha1/packs/comms/system-collective-library.json",
 "title": "comms/collective-library",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "library": {
   "enum": [
    "lib-a",
    "lib-b"
   ]
  },
  "precision": {
   "enum": [
    "fp32",
    "bf16",
    "fp16"
   ]
  },
  "world_size": {
   "type": "integer",
   "minimum": 2
  },
  "flags": {
   "type": "object",
   "description": "tool flags verbatim (native names); identity unless listed in non_identity"
  }
 },
 "required": [
  "library",
  "world_size"
 ]
}
