{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.bench.invalid/v1alpha1/packs/llm-serving/workload-generate.json",
 "title": "llm/generate: data-producing workload",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "sampling": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "temperature": {
     "type": "number",
     "minimum": 0
    },
    "top_p": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "max_tokens": {
     "type": "integer",
     "minimum": 1
    },
    "ignore_eos": {
     "type": "boolean"
    }
   }
  }
 },
 "required": [
  "sampling"
 ]
}
