{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.bench.invalid/v1alpha1/pack.schema.json",
 "title": "bench/v1alpha1 Pack",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "apiVersion": {
   "const": "bench/v1alpha1"
  },
  "kind": {
   "const": "Pack"
  },
  "metadata": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "$ref": "#/$defs/name"
    },
    "description": {
     "type": "string"
    },
    "owner": {
     "$ref": "#/$defs/owner"
    },
    "labels": {
     "$ref": "#/$defs/labels"
    },
    "tags": {
     "$ref": "#/$defs/tags"
    },
    "links": {
     "$ref": "#/$defs/links"
    },
    "annotations": {
     "$ref": "#/$defs/annotations"
    }
   },
   "required": [
    "name"
   ]
  },
  "spec": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "prefix": {
     "$ref": "#/$defs/prefix"
    },
    "version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "requires": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "core": {
       "type": "string"
      }
     }
    },
    "depends": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "pack": {
        "$ref": "#/$defs/name"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "pack",
       "version"
      ]
     }
    },
    "types": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
       },
       "for": {
        "enum": [
         "System",
         "Workload",
         "Store"
        ]
       },
       "schema": {
        "type": "string"
       },
       "non_identity": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "levels": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "runner": {
        "$ref": "#/$defs/name"
       },
       "default_metrics": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/metric"
        }
       },
       "load": {
        "type": "array",
        "items": {
         "enum": [
          "closed",
          "open",
          "batch",
          "iterations",
          "ramp"
         ]
        },
        "description": "executors the workload type accepts; empty = no load block"
       },
       "scenarios": {
        "type": "object",
        "additionalProperties": {
         "$ref": "#/$defs/load"
        }
       },
       "refs": {
        "type": "object",
        "additionalProperties": {
         "enum": [
          "Model",
          "Asset"
         ]
        },
        "description": "typed field -> kind; identity uses the referenced id, not the name"
       },
       "description": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "for",
       "schema"
      ]
     }
    },
    "extensions": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "for": {
        "enum": [
         "System",
         "Environment",
         "NodeClass"
        ]
       },
       "schema": {
        "type": "string"
       },
       "identity": {
        "type": "boolean"
       }
      },
      "required": [
       "for",
       "schema"
      ]
     }
    },
    "vocabularies": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "test_types": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "levels": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "purposes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "attributes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "key": {
        "$ref": "#/$defs/attr"
       },
       "class": {
        "enum": [
         "identity",
         "subject",
         "label",
         "environment",
         "run"
        ]
       },
       "role": {
        "enum": [
         "root",
         "derived"
        ]
       },
       "derived_from": {
        "$ref": "#/$defs/attr"
       },
       "type": {
        "enum": [
         "string",
         "int",
         "float",
         "bool",
         "enum",
         "uuid"
        ]
       },
       "values": {
        "type": "array",
        "items": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "number"
          },
          {
           "type": "boolean"
          }
         ]
        }
       },
       "unit": {
        "type": "string"
       },
       "order": {
        "enum": [
         "numeric",
         "lexical",
         "declared"
        ]
       },
       "plot": {
        "type": "boolean"
       },
       "fingerprint": {
        "type": "boolean"
       },
       "stored_in": {
        "type": "string"
       },
       "description": {
        "type": "string"
       }
      },
      "required": [
       "key",
       "class",
       "role",
       "type"
      ]
     }
    },
    "device_classes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
       },
       "kind": {
        "enum": [
         "accelerator",
         "cpu",
         "storage",
         "network"
        ]
       },
       "attributes": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "name": {
           "$ref": "#/$defs/attr"
          },
          "type": {
           "enum": [
            "string",
            "int",
            "float",
            "bool"
           ]
          },
          "values": {
           "type": "array",
           "items": {
            "anyOf": [
             {
              "type": "string"
             },
             {
              "type": "number"
             },
             {
              "type": "boolean"
             }
            ]
           }
          }
         },
         "required": [
          "name",
          "type"
         ]
        }
       }
      },
      "required": [
       "name",
       "kind"
      ]
     }
    },
    "metrics": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "$ref": "#/$defs/metric"
       },
       "unit": {
        "type": "string",
        "description": "UCUM, e.g. s, By, {request}/s, {token}/s, W, 1"
       },
       "direction": {
        "enum": [
         "lower_is_better",
         "higher_is_better",
         "none"
        ]
       },
       "category": {
        "enum": [
         "performance",
         "quality",
         "efficiency",
         "capability",
         "diagnostic"
        ]
       },
       "statistic": {
        "enum": [
         "value",
         "mean",
         "median",
         "p90",
         "p99",
         "max",
         "min",
         "count",
         "ratio",
         "sum"
        ]
       },
       "compare": {
        "enum": [
         "relative",
         "absolute",
         "exact"
        ]
       },
       "noise": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "min_repeats": {
          "type": "integer",
          "minimum": 1
         },
         "cv_max": {
          "type": "number",
          "minimum": 0
         }
        }
       },
       "otel": {
        "type": "string"
       },
       "description": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "unit",
       "direction",
       "category"
      ]
     }
    },
    "relations": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
     },
     "description": "pack relation names, used as <prefix>/<name>"
    },
    "runners": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "$ref": "#/$defs/name"
       },
       "protocol": {
        "enum": [
         "process/v1",
         "python/v1"
        ]
       },
       "command": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 1
       },
       "entry_point": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "protocol"
      ]
     }
    },
    "probes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "$ref": "#/$defs/name"
       },
       "protocol": {
        "enum": [
         "process/v1",
         "python/v1"
        ]
       },
       "command": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "entry_point": {
        "type": "string"
       },
       "produces": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/attr"
        }
       }
      },
      "required": [
       "name",
       "protocol",
       "produces"
      ]
     }
    },
    "analyzers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*/[a-z][a-z0-9-]*$"
       },
       "consumes": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "produces": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/attr"
        }
       },
       "provenance": {
        "enum": [
         "derived",
         "measured"
        ]
       },
       "gating": {
        "type": "boolean"
       }
      },
      "required": [
       "name"
      ]
     }
    },
    "resolvers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*/[a-z][a-z0-9-]*$"
       },
       "produces": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/attr"
        }
       }
      },
      "required": [
       "name"
      ]
     },
     "description": "turn a build reference into subject.id and subject.dep.* attributes"
    },
    "gates": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "id": {
        "$ref": "#/$defs/attr"
       },
       "phase": {
        "enum": [
         "pre",
         "in",
         "post",
         "ingest"
        ]
       },
       "check": {
        "type": "string"
       },
       "reason": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
       }
      },
      "required": [
       "id",
       "phase",
       "reason"
      ]
     }
    },
    "storage": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "attribute": {
        "$ref": "#/$defs/attr"
       },
       "column": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "attribute",
       "column"
      ]
     }
    }
   },
   "required": [
    "prefix",
    "version"
   ],
   "description": "registers a pack: types, extensions, vocabularies, attribute registry, device classes, metrics, runners, probes, analyzers, resolvers"
  }
 },
 "required": [
  "apiVersion",
  "kind",
  "metadata",
  "spec"
 ],
 "$defs": {
  "name": {
   "type": "string",
   "pattern": "^[a-z0-9]([a-z0-9._@-]{0,126}[a-z0-9])?$"
  },
  "case_name": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._=/,@-]{0,199}$",
   "description": "label of a case; not identity (benchmark_id is derived)"
  },
  "type_ref": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]*/[a-z][a-z0-9-]*$",
   "description": "<pack prefix>/<registered name>, e.g. llm/serve"
  },
  "prefix": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]{0,15}$"
  },
  "attr": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_<>-]+)+$",
   "description": "registry key; <name> marks a variable segment"
  },
  "attr_glob": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_<>*-]+)*(\\.\\*)?$",
   "description": "attribute key or glob over registry keys"
  },
  "metric": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
  },
  "owner": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$|^<[a-z-]+>$"
  },
  "labels": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "maxLength": 63
   },
   "description": "selector key/values"
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
   },
   "description": "hashed into benchmark_id unless in a run-context namespace (platform__, testtype__, cadence__)"
  },
  "links": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "annotations": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "arch": {
   "enum": [
    "x86_64",
    "ppc64le",
    "s390x",
    "aarch64"
   ]
  },
  "duration": {
   "type": "string",
   "pattern": "^[0-9]+(\\.[0-9]+)?(s|m|h|d)$",
   "description": "e.g. 90s, 10m, 2h"
  },
  "env": {
   "type": "object",
   "additionalProperties": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ]
   },
   "description": "process environment knobs; run attributes"
  },
  "extensions": {
   "type": "object",
   "additionalProperties": {
    "type": "object"
   },
   "description": "pack prefix -> block validated by that pack's extension schema for this kind"
  },
  "valref": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "env": {
     "type": "string"
    },
    "value": {
     "type": "string"
    }
   },
   "description": "a value or the name of an environment variable; never a secret"
  },
  "predicate": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "string"
    },
    "eq": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "ne": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "gt": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "gte": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "lt": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "lte": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "in": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     }
    },
    "notin": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     }
    },
    "between": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "exists": {
     "type": "boolean"
    },
    "matches": {
     "type": "string"
    },
    "any": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/predicate"
     },
     "minItems": 1
    },
    "not": {
     "$ref": "#/$defs/predicate"
    }
   },
   "description": "structured filter predicate: {field, one op}, or {any: [...]}, or {not: {...}}"
  },
  "select": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "from": {
     "type": "string",
     "description": "asset name inside the Dataset"
    },
    "files": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "split": {
     "type": "string"
    },
    "filter": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/predicate"
     }
    },
    "columns": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "order": {
     "anyOf": [
      {
       "enum": [
        "sequential"
       ]
      },
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "shuffle": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "seed": {
           "type": "integer"
          }
         },
         "required": [
          "seed"
         ]
        }
       },
       "required": [
        "shuffle"
       ]
      }
     ]
    },
    "offset": {
     "type": "integer",
     "minimum": 0
    },
    "limit": {
     "type": "integer",
     "minimum": 1
    },
    "sample": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "n": {
       "type": "integer",
       "minimum": 1
      },
      "fraction": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "seed": {
       "type": "integer"
      },
      "stratify_by": {
       "type": "string"
      }
     },
     "required": [
      "seed"
     ]
    },
    "ids": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     },
     "required": [
      "file",
      "sha256"
     ]
    },
    "repeat": {
     "enum": [
      "none",
      "cycle"
     ]
    }
   },
   "description": "pure function of (asset contents, select); every random operation carries a seed"
  },
  "input": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "$ref": "#/$defs/name"
    },
    "dataset": {
     "$ref": "#/$defs/name"
    },
    "asset": {
     "$ref": "#/$defs/name"
    },
    "model": {
     "$ref": "#/$defs/name"
    },
    "subset": {
     "type": "string",
     "description": "named subset of the Dataset; inline select fields override it"
    },
    "select": {
     "$ref": "#/$defs/select"
    },
    "expect": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "records": {
       "type": "integer",
       "minimum": 0
      },
      "selection_digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      }
     }
    },
    "digest": {
     "enum": [
      "off",
      "on_expect",
      "always"
     ],
     "description": "selection_digest policy; default on_expect"
    },
    "access": {
     "enum": [
      "path",
      "reader"
     ]
    }
   },
   "required": [
    "name"
   ],
   "description": "exactly one of dataset, asset, model"
  },
  "load": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "executor": {
     "enum": [
      "closed",
      "open",
      "batch",
      "iterations",
      "ramp"
     ]
    },
    "concurrency": {
     "type": "integer",
     "minimum": 1
    },
    "requests": {
     "type": "integer",
     "minimum": 1
    },
    "duration": {
     "$ref": "#/$defs/duration"
    },
    "rate": {
     "anyOf": [
