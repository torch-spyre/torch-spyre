{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.bench.invalid/v1alpha1/analysis.schema.json",
 "title": "bench/v1alpha1 Analysis",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "apiVersion": {
   "const": "bench/v1alpha1"
  },
  "kind": {
   "const": "Analysis"
  },
  "metadata": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "$ref": "#/$defs/name"
    },
    "description": {
     "type": "string"
    },
    "owner": {
     "$ref": "#/$defs/owner"
    },
    "labels": {
     "$ref": "#/$defs/labels"
    },
    "tags": {
     "$ref": "#/$defs/tags"
    },
    "links": {
     "$ref": "#/$defs/links"
    },
    "annotations": {
     "$ref": "#/$defs/annotations"
    }
   },
   "required": [
    "name"
   ]
  },
  "spec": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "select": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "benchmarks": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/name"
       },
       "minItems": 1
      },
      "via": {
       "enum": [
        "relations"
       ]
      },
      "groupings": {
       "type": "object",
       "additionalProperties": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "number"
         },
         {
          "type": "boolean"
         }
        ]
       }
      }
     },
     "required": [
      "benchmarks"
     ]
    },
    "metric": {
     "$ref": "#/$defs/metric"
    },
    "hold": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/attr_glob"
     }
    },
    "relax": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/attr_glob"
     }
    },
    "vary": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/attr_glob"
     },
     "minItems": 1
    },
    "output": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "controlled_sets": {
       "type": "boolean"
      },
      "rank_variables": {
       "type": "boolean"
      },
      "noise": {
       "enum": [
        "series_floor",
        "none"
       ]
      },
      "chart": {
       "type": "string"
      }
     }
    },
    "decompose": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "from": {
       "$ref": "#/$defs/name"
      },
      "to": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/name"
       },
       "minItems": 1
      },
      "show": {
       "enum": [
        "residual"
       ]
      }
     },
     "required": [
      "from",
      "to"
     ]
    },
    "derive": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "name": {
       "$ref": "#/$defs/metric"
      },
      "op": {
       "enum": [
        "difference",
        "ratio",
        "slope"
       ]
      },
      "cases": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "first": {
         "$ref": "#/$defs/case_name"
        },
        "second": {
         "$ref": "#/$defs/case_name"
        }
       },
       "required": [
        "first",
        "second"
       ],
       "description": "difference = first - second; ratio = first / second; slope = (first - second) / (x.first - x.second)"
      },
      "x": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "first": {
         "type": "number"
        },
        "second": {
         "type": "number"
        }
       },
       "required": [
        "first",
        "second"
       ],
       "description": "slope only: the x value of each case, e.g. output tokens"
      },
      "unit": {
       "type": "string",
       "description": "default: the metric unit; 1 for ratio"
      }
     },
     "required": [
      "name",
      "op",
      "cases"
     ],
     "description": "a metric computed per repeat pair from two cases of one subject and environment; `metric` is the input"
    },
    "compare": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "by": {
       "$ref": "#/$defs/attr"
      },
      "across": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/attr"
       }
      },
      "metric": {
       "$ref": "#/$defs/metric"
      },
      "baseline": {
       "type": "string",
       "description": "`by` value the effect is relative to; default none, else the first"
      }
     },
     "required": [
      "by",
      "metric"
     ],
     "description": "a table of per-cell statistics over `by` within each `across` combination; metric may be derive.name"
    },
    "reference": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "case": {
       "$ref": "#/$defs/case_name"
      },
      "value": {
       "type": "number"
      },
      "stderr": {
       "type": "number",
       "minimum": 0
      },
      "n": {
       "type": "integer",
       "minimum": 1
      },
      "label": {
       "type": "string",
       "description": "abstract name of an inline reference, e.g. cpu-fp32-ref"
      },
      "stderr_metric": {
       "$ref": "#/$defs/metric"
      },
      "tolerance": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "stderr": {
         "type": "number",
         "minimum": 0,
         "description": "allowed shortfall in combined standard errors; a single run is `regressed` only from 4 combined standard errors, a smaller shortfall past the allowance is `suspected`"
        },
        "abs": {
         "type": "number",
         "minimum": 0,
         "description": "practical floor: a shortfall below it is never worse"
        }
       },
       "description": "at least one of stderr, abs; both set = the larger allowance"
      }
     },
     "required": [
      "tolerance"
     ],
     "description": "quality: compare the score of each selected Result with a reference (the Result of `case`, or an inline value with its stderr or n); `metric` is the score. Advisory: never gates, and a Result whose validity is suspect or invalid is reported as such, never as regressed"
    }
   },
   "required": [
    "select",
    "metric",
    "vary"
   ],
   "description": "a query over stored results, not a run: unlisted keys are held; unknown attributes are never held"
  }
 },
 "required": [
  "apiVersion",
  "kind",
  "metadata",
  "spec"
 ],
 "$defs": {
  "name": {
   "type": "string",
   "pattern": "^[a-z0-9]([a-z0-9._@-]{0,126}[a-z0-9])?$"
  },
  "case_name": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._=/,@-]{0,199}$",
   "description": "label of a case; not identity (benchmark_id is derived)"
  },
  "type_ref": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]*/[a-z][a-z0-9-]*$",
   "description": "<pack prefix>/<registered name>, e.g. llm/serve"
  },
  "prefix": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]{0,15}$"
  },
  "attr": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_<>-]+)+$",
   "description": "registry key; <name> marks a variable segment"
  },
  "attr_glob": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_<>*-]+)*(\\.\\*)?$",
   "description": "attribute key or glob over registry keys"
  },
  "metric": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
  },
  "owner": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$|^<[a-z-]+>$"
  },
  "labels": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "maxLength": 63
   },
   "description": "selector key/values"
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
   },
   "description": "hashed into benchmark_id unless in a run-context namespace (platform__, testtype__, cadence__)"
  },
  "links": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "annotations": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "arch": {
   "enum": [
    "x86_64",
    "ppc64le",
    "s390x",
    "aarch64"
   ]
  },
  "duration": {
   "type": "string",
   "pattern": "^[0-9]+(\\.[0-9]+)?(s|m|h|d)$",
   "description": "e.g. 90s, 10m, 2h"
  },
  "env": {
   "type": "object",
   "additionalProperties": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ]
   },
   "description": "process environment knobs; run attributes"
  },
  "extensions": {
   "type": "object",
   "additionalProperties": {
    "type": "object"
   },
   "description": "pack prefix -> block validated by that pack's extension schema for this kind"
  },
  "valref": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "env": {
     "type": "string"
    },
    "value": {
     "type": "string"
    }
   },
   "description": "a value or the name of an environment variable; never a secret"
  },
  "predicate": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "string"
    },
    "eq": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "ne": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "gt": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "gte": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "lt": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "lte": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "in": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     }
    },
    "notin": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     }
    },
    "between": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     },
     "minItems": 2,
     "maxItems": 2
    },
    "exists": {
     "type": "boolean"
    },
    "matches": {
     "type": "string"
    },
    "any": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/predicate"
     },
     "minItems": 1
    },
    "not": {
     "$ref": "#/$defs/predicate"
    }
   },
   "description": "structured filter predicate: {field, one op}, or {any: [...]}, or {not: {...}}"
  },
  "select": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "from": {
     "type": "string",
     "description": "asset name inside the Dataset"
    },
    "files": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "split": {
     "type": "string"
    },
    "filter": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/predicate"
     }
    },
    "columns": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "order": {
     "anyOf": [
      {
       "enum": [
        "sequential"
       ]
      },
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "shuffle": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "seed": {
           "type": "integer"
          }
         },
         "required": [
          "seed"
         ]
        }
       },
       "required": [
        "shuffle"
       ]
      }
     ]
    },
    "offset": {
     "type": "integer",
     "minimum": 0
    },
    "limit": {
     "type": "integer",
     "minimum": 1
    },
    "sample": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "n": {
       "type": "integer",
       "minimum": 1
      },
      "fraction": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "seed": {
       "type": "integer"
      },
      "stratify_by": {
       "type": "string"
      }
     },
     "required": [
      "seed"
     ]
    },
    "ids": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     },
     "required": [
      "file",
      "sha256"
     ]
    },
    "repeat": {
     "enum": [
      "none",
      "cycle"
     ]
    }
   },
   "description": "pure function of (asset contents, select); every random operation carries a seed"
  },
  "input": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "$ref": "#/$defs/name"
    },
    "dataset": {
     "$ref": "#/$defs/name"
    },
    "asset": {
     "$ref": "#/$defs/name"
    },
    "model": {
     "$ref": "#/$defs/name"
    },
    "subset": {
     "type": "string",
     "description": "named subset of the Dataset; inline select fields override it"
    },
    "select": {
     "$ref": "#/$defs/select"
    },
    "expect": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "records": {
       "type": "integer",
       "minimum": 0
      },
      "selection_digest": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      }
     }
    },
    "digest": {
     "enum": [
      "off",
      "on_expect",
      "always"
     ],
     "description": "selection_digest policy; default on_expect"
    },
    "access": {
     "enum": [
      "path",
      "reader"
     ]
    }
   },
   "required": [
    "name"
   ],
   "description": "exactly one of dataset, asset, model"
  },
  "load": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "executor": {
     "enum": [
      "closed",
      "open",
      "batch",
      "iterations",
      "ramp"
     ]
    },
    "concurrency": {
     "type": "integer",
     "minimum": 1
    },
    "requests": {
     "type": "integer",
     "minimum": 1
    },
    "duration": {
     "$ref": "#/$defs/duration"
    },
    "rate": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "const": "inf"
      }
     ]
    },
    "arrival": {
     "enum": [
      "poisson",
      "uniform"
     ]
    },
    "warmup": {
     "$ref": "#/$defs/duration"
    },
    "warmup_requests": {
     "type": "integer",
     "minimum": 0
    },
    "iterations": {
     "type": "integer",
     "minimum": 1
    },
    "warmup_iterations": {
     "type": "integer",
     "minimum": 0
    },
    "stages": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "duration": {
        "$ref": "#/$defs/duration"
       },
       "target": {
        "type": "number",
        "minimum": 0
       }
      },
      "required": [
       "duration",
       "target"
      ]
     },
     "minItems": 1
    }
   },
   "required": [
    "executor"
   ],
   "description": "closed {concurrency, requests|duration}; open {rate, requests|duration}; batch {requests}; iterations {iterations}; ramp {stages}"
  },
  "slo": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "lte": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)?(us|ms|s)$"
       }
      ]
     },
     "gte": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)?(us|ms|s)$"
       }
      ]
     }
    }
   },
   "description": "metric name -> bound; hashed in base units"
  },
  "workload_inline": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "base": {
     "$ref": "#/$defs/name"
    },
    "patch": {
     "type": "object"
    },
    "type": {
     "$ref": "#/$defs/type_ref"
    }
   },
   "description": "a named Workload extended with `patch`, or a typed inline spec"
  },
  "system_inline": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "base": {
     "$ref": "#/$defs/name"
    },
    "patch": {
     "type": "object"
    },
    "type": {
     "$ref": "#/$defs/type_ref"
    }
   }
  },
  "tier": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$"
  },
  "groupings_value": {
   "anyOf": [
    {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       }
      ]
     },
     "minItems": 1
    }
   ]
  },
  "run": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "cache": {
     "enum": [
      "warm",
      "cold",
      "both"
     ]
    },
    "repeats": {
     "type": "integer",
     "minimum": 1
    },
    "isolation": {
     "enum": [
      "session",
      "process"
     ]
    },
    "timeout": {
     "$ref": "#/$defs/duration"
    },
    "est": {
     "$ref": "#/$defs/duration"
    },
    "runner": {
     "type": "string",
     "pattern": "^[a-z0-9]([a-z0-9._@-]{0,126}[a-z0-9])?$"
    },
    "seed": {
     "type": "integer"
    },
    "fresh_cache": {
     "type": "boolean"
    },
    "allow_empty": {
     "type": "boolean",
     "description": "a run that exits 0 without raw output or metrics.json is not a failure"
    },
    "command": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1,
     "description": "argv with {tokens}; see docs/README.md (Running)"
    },
    "ingest": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1,
     "description": "argv of the ingest hand-off, same tokens"
    }
   },
   "description": "run attributes: never identity; overridable at run time"
  },
  "identity": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "mode": {
     "enum": [
      "engine",
      "ingest"
     ]
    },
    "profile": {
     "enum": [
      "perf-kernel",
      "vllm",
      "vllm-sweep",
      "generic"
     ],
     "description": "which ingest producer's key list is hashed; default perf-kernel"
    },
    "component": {
     "type": "string",
     "description": "the ingest's component; lower-case, validated by the engine"
    },
    "name": {
     "type": "string",
     "description": "the ingest's benchmark name; lower-case, underscores allowed"
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
     },
     "description": "identity tags only; groupings are run props"
    },
    "discriminators": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "key": {
        "type": "string"
       },
       "value": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "number"
         },
         {
          "type": "boolean"
         }
        ]
       },
       "from": {
        "type": "string",
        "description": "a case.*, system.* or input.* identity value"
       },
       "join": {
        "type": "string",
        "description": "joins a list value into the discriminator string"
       }
      },
      "required": [
       "key"
      ]
     },
